# Database Configuration
DATABASE_URL=postgresql://cybermaps_user:your_password@localhost:5432/cybermaps

# Coralogix Webhook Configuration
CORALOGIX_WEBHOOK_SECRET=your-webhook-secret-here

# Azure Sentinel Configuration (for future)
SENTINEL_TENANT_ID=your-tenant-id
SENTINEL_CLIENT_ID=your-client-id
SENTINEL_CLIENT_SECRET=your-client-secret

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
